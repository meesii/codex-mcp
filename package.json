{
    "name": "@meesii/codex-mcp",
    "version": "0.8.0",
    "description": "Lean local coding MCP server for ChatGPT with embedded OAuth and Streamable HTTP.",
    "type": "module",
    "main": "dist/cli.js",
    "files": [
        "dist/**/*.js",
        "scripts/install.sh",
        "scripts/install.ps1",
        "README.md",
        "LICENSE"
    ],
    "bin": {
        "codex-mcp": "dist/cli.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "tsx watch src/cli.ts",
        "dev:once": "tsx src/cli.ts",
        "dev:watch": "tsx watch src/cli.ts",
        "build": "esbuild \"src/**/*.ts\" --outdir=dist --outbase=src --format=esm --platform=node --target=es2022 --minify",
        "prepack": "npm run build",
        "start": "node dist/cli.js",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "pretest": "npm run build",
        "test": "tsx --test --test-concurrency=1 test/contracts/all.contract.test.ts",
        "bench:perf": "tsx test/performance-benchmark.ts"
    },
    "keywords": [
        "mcp",
        "chatgpt",
        "coding"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meesii/codex-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/meesii/codex-mcp/issues"
    },
    "homepage": "https://github.com/meesii/codex-mcp#readme",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@clack/prompts": "^1.7.0",
        "@modelcontextprotocol/express": "^2.0.0",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@modelcontextprotocol/server": "^2.0.0",
        "@node-rs/argon2": "^2.0.2",
        "cross-spawn": "^7.0.6",
        "express": "^5.2.1",
        "fflate": "^0.8.3",
        "http-proxy-agent": "^9.1.0",
        "https-proxy-agent": "^9.1.0",
        "jose": "^6.2.8",
        "minimatch": "^10.2.6",
        "pino": "^10.3.1",
        "pino-roll": "^4.0.0",
        "socks-proxy-agent": "^10.1.0",
        "tar": "^7.5.22",
        "turndown": "^7.2.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.19.0",
        "@types/turndown": "^5.0.6",
        "esbuild": "^0.28.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
