{
    "name": "codex-mcp",
    "version": "0.1.1",
    "description": "Lean local coding MCP server for ChatGPT with embedded OAuth and Streamable HTTP.",
    "type": "module",
    "main": "dist/cli.js",
    "files": [
        "dist/**/*.js",
        "README.md",
        "LICENSE"
    ],
    "bin": {
        "codex-mcp": "dist/cli.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "tsx src/cli.ts",
        "dev:watch": "tsx watch src/cli.ts",
        "build": "tsc -p tsconfig.json",
        "prepack": "npm run build",
        "start": "node dist/cli.js",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "test": "tsx test/user-mcp-config.test.ts && tsx test/user-capabilities.test.ts && tsx test/codex-import.test.ts && tsx test/agents.test.ts && tsx test/skills.test.ts && tsx test/capability-watcher.test.ts && tsx test/tools.e2e.test.ts && tsx test/workspace-git.test.ts && tsx test/capability-policy.test.ts && tsx test/mcp-gateway.e2e.test.ts && tsx test/security-regressions.test.ts && tsx test/private-key-jwt.test.ts && tsx test/oauth.e2e.test.ts",
        "bench:perf": "tsx test/performance-benchmark.ts"
    },
    "keywords": [
        "mcp",
        "chatgpt",
        "coding"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meesii/codex-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/meesii/codex-mcp/issues"
    },
    "homepage": "https://github.com/meesii/codex-mcp#readme",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/express": "^2.0.0",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@modelcontextprotocol/server": "^2.0.0",
        "@node-rs/argon2": "^2.0.2",
        "express": "^5.2.1",
        "https-proxy-agent": "^9.1.0",
        "jose": "^6.2.8",
        "minimatch": "^10.2.6",
        "turndown": "^7.2.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.19.0",
        "@types/turndown": "^5.0.6",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
