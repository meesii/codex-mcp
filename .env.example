CODING_MCP_HOST=127.0.0.1
CODING_MCP_PORT=3920
# Absolute path to the single project directory this server exposes
CODING_MCP_PROJECT_ROOT=
# Tunnel / public Host header allow-list (semicolon-separated, no ports)
# Example: mcp.xxx.com
CODING_MCP_ALLOWED_HOSTS=
# Unique HTTPS origin for ChatGPT widget sandbox (required for submission warnings).
# Default when unset: https://codex-mcp.<first ALLOWED_HOST>
# Example: https://codex-mcp.mcp.xxx.com
CODING_MCP_WIDGET_DOMAIN=
# Tool call logs (1/true default). Never dumps full file/command bodies.
CODING_MCP_LOG_TOOLS=1
